?shift
ib$detection.id<- ifelse(ib$receiver.site == 1 & shift(ib$receiver.site == 1, n = 1L, type = "lag"), 11, NA)
View(ib)
#' create column of unique antenna detection patterns to determine detection efficiency
#' eg 11 means read at receiver 1 then 1 again (zero misses), 13 means read at receiver
#' 1 then receiver 3 which means 2 missed it (skip)
#'good reads == 11, 12, 21, 22, 23, 32, 33, 34, 43, 44
ib$detection.id<- ifelse(ib$receiver.site == 1 & shift(ib$receiver.site == 1, n = 1L, type = "lag"), 11,
ifelse(ib$receiver.site ==1 & shift(ib$receiver.site ==2, n = 1L, type = "lag"), 12,
ifelse(ib$receiver.site == 2 & shift(ib.receiver.site == 1, n = 1L, type = "lag"), 21,
ifelse(ib$receiver.site == 2 & shift(ib.receiver.site ==2, n = 1L, type = "lag"), 22,
ifelse(ib$receiver.site == 2 & shift(ib.receivver.site == 3, n = 1L, type = "lag"), 23,
ifelse(ib$receiver.site == 3 & shift(ib.receivver.site == 2, n = 1L, type = "lag"), 32,
ifelse(ib$receiver.site == 3 & shift(ib.receivver.site == 3, n = 1L, type = "lag"), 33,
ifelse(ib$receiver.site == 3 & shift(ib.receivver.site == 4, n = 1L, type = "lag"), 34,
ifelse(ib$receiver.site == 4 & shift(ib.receivver.site == 3, n = 1L, type = "lag"), 43,
ifelse(ib$receiver.site == 4 & shift(ib.receivver.site == 4, n = 1L, type = "lag"), 23, 0))))))))))
