#'Randomly generate the number of animals in a study area using a gamma
#'distribution with mean animal abundance of 100 with a standard deviation of
#'25 (hint: use methods of moments) and a Poisson distribution.
?rgamma
#######################################################
## Estimate parameters of gamma with method of moments
#######################################################
gamma.mom<-function(mean,sd){
v<-sd**2
x<-mean
a<- (mean/sd)^2 #shape
b<-(sd^2)/mean #scale
c(a,b)
}
gamma.mom
gamma.mom<-function(mean,sd){
v<-sd**2
x<-mean
a<- (mean/sd)^2 #shape
b<-(sd^2)/mean #scale
c(a,b)
}
gamma.mom(10,25)
gamma.mom(100,25) #what are the shape and scale with a mean of 100 and a sd of 25?
n_reps<-1000
c<-16
b<-6.25
lambda<-rgamma(n_reps,c,b)
x<-rpois(n_reps,lambda) #randomly generated means
n_reps<-1000
my.shape<-16
my.scale<-6.25
lambda<-rgamma(n_reps,my.shape,my.scale)
x<-rpois(n_reps,lambda) #randomly generated means
n_reps<-1000
my.shape<-16
my.scale<-6.25
lambda<-rgamma(n_reps,my.shape, scale = my.scale)
x<-rpois(n_reps,lambda) #randomly generated means
beta.mom<-function(mean,sd){
v<-sd**2
x<-mean
a<-x*(x*(1-x)/v-1)
b<-(1-x)*(x*(1-x)/v-1)
c(a,b)
}
beta.mom(.75, .25)
?beta
n <- 1000
a <- 1.5
b<- 0.5
detection <- rbeta(n, a, b)
?rbeta
capture <- x*detection
capture
mean(capture)
sd(capture)
#' a)	Randomly generate 1000 air temperatures with a mean of 10 and standard
#' deviation of 22
rnorm(1000, 10, 22)
#' beacause air temperatures can be negative and positive, are continuous variables (not discreet)
#' parameters were the mean of 10 and
?rnorm
gamma.mom<-function(mean,sd){
v<-sd**2
x<-mean
a<- (mean/sd)^2 #shape
b<-(sd^2)/mean #scale
c(a,b)
}
gamma.mom(1000,1570)
n_reps<-500
my.shape<-0.405696
my.scale<-2464.90
lambda<-rgamma(n_reps,my.shape, scale = my.scale)
x<-rpois(n_reps,lambda) #randomly generated means
x
max(x)
mean(x)
#' c)	Randomly generate 25 years of hurricane landfalls assuming a mean number of
#' landfalls per year of 4 with a standard deviation of 2.
#' mean and variance are equal, discrete and positive only, poisson
n<- 25
lambda <- 4
hurricane<-rpois(n,lambda)
hurricane
beta.mom<-function(mean,sd){
v<-sd**2
x<-mean
a<-x*(x*(1-x)/v-1)
b<-(1-x)*(x*(1-x)/v-1)
c(a,b)
}
beta.mom(.5, .5) #output alpha and beta with mean of 0.75 and sd of 0.25
install.packages("jags")
library(JAGS)
library(readr)
library(tidyverse)
library(lubridate)
library(dplyr)
library(data.table)
library(rgdal)
setwd("C:/Users/barrehan/GitHub/projects/cwa.habitat.selection")
#'assign fish location (receiver site/antenna number) to closest DO/temp array
#'use temperature to interoplate depth and DO for that timestep
fish.dat <- read.csv('data/modif.data/radio.tag/tag.reads.10.min.interval.csv')
fish.dat$date.time = mdy_hm(fish.dat$date.time)
receiver.dat <- unique(fish.dat[c("receiver.site", "antenna.number", "lat", 'long')])
receiver.dat<- receiver.dat %>%arrange(receiver.site, antenna.number)
receiver.dat$ID <- 1:nrow(receiver.dat)
logger.dat<- read.csv('data/raw.data/logger.array/logger.array.setup.csv')
logger.dat<- logger.dat[!(logger.dat$site == "telemetry.slough"),]
logger.dat <- logger.dat[-c(1,3:7,10:12)]
logger.dat<-unique(logger.dat[c(1:3)])
#plot all points on map
br.poly <- readOGR("data/modif.data/blue.ruin.polygon/brpolygon.shp")
##figure out what the projection is so I can use it for my radio tag data below
br.poly@proj4string
plot(br.poly, axes = TRUE)
plot(br.poly, height = 700, width = 900)
##you have to fortify your shapefile to make it work with ggplot2
br.poly <- fortify(br.poly)
# Now the shapefile can be plotted as either a geom_path or a geom_polygon.
# Paths handle clipping better. Polygons can be filled.
# You need the aesthetics long, lat, and group.
receiver.dat$ID<-as.factor(receiver.dat$ID)
ggplot() +
geom_polygon(data = br.poly,
aes(x = long, y = lat, group = group), fill = "light grey")
colors <- c("#D8B70A", "#D67236", "#02401B", "#A2A475", "#81A88D", "#972D15")
map.points <- ggplot() +
geom_polygon(data =br.poly,
aes(x = long, y = lat, group = group), fill = "light grey") +
geom_jitter(data = receiver.dat,
aes(x=long, y = lat, colour = ID), width = 0.00001, size = 2, shape = 16)+
scale_color_manual(values = colors)+
geom_point(data = logger.dat,
aes(x = lon, y = lat), size = 2, shape = 6)+
theme_bw() + theme(panel.border = element_blank(), panel.grid.major = element_blank(),
panel.grid.minor = element_blank(), axis.line = element_line(colour = "black"))+
labs(color = "Antenna")
#ggsave("results/figures/radio.tag.figures/blue.ruin.arrays.receivers.png", width = 15, height = 10, units = "cm")
fish.dat$antenna.number<- ifelse(fish.dat$receiver.site == 1 & fish.dat$antenna.number ==1, "site.0.mouth",
ifelse(fish.dat$receiver.site == 1 & fish.dat$antenna.number ==2, "site.1",
ifelse(fish.dat$receiver.site == 2 & fish.dat$antenna.number == 1, "site.2",
ifelse(fish.dat$receiver.site == 2 & fish.dat$antenna.number == 2, "site.3",
ifelse(fish.dat$receiver.site == 3, "site.3",
ifelse(fish.dat$receiver.site == 4, "site.4.netpen", NA))))))
#'import all array .csvs and create one data frame of all combined, for loop to assign fish to array and timestamp, interpolation
#'estimate fish depth
s0<- read.csv("data/raw.data/logger.array/blue.ruin.site.0.river.temp.csv")
s0$date.time<-mdy_hm(s0$date.time)
s1<- read.csv("data/raw.data/logger.array/blue.ruin.site.1.mouth.temp.do.csv")
s1$date.time<-mdy_hm(s1$date.time)
#'round to nearest 5 min interval
s1$date.time<-round_date(s1$date.time,unit="5 minutes")
s2<-read.csv("data/modif.data/logger.array/blue.ruin.site.2.array.do.temp.csv")
s2$date.time<-ymd_hms(s2$date.time)
s3<-read.csv("data/raw.data/logger.array/blue.ruin.site.3.mid.temp.do.csv")
s3$date.time<-mdy_hm(s3$date.time)
s4<- read.csv("data/modif.data/logger.array/blue.ruin.netpen.array.do.temp.csv")
s4$date.time<-mdy_hm(s4$date.time)
arrays<- do.call("rbind", list(s0, s1, s2, s3, s4))
#'curtail fish dat to narrowest array timeframe 7/26 - 8/15
fish <- fish.dat[fish.dat$date.time >= "2021-07-26 00:00:00" & fish.dat$date.time < "2021-08-15 07:50:00",]
View(fish)
fish.dat <- fish.dat %>% force_tz(fish.dat$date.time, tzone = "America/Los_Angeles")
arrays <- arrays %>% force_tz(arrays$date.time, tzone = "America/Los_Angeles")
#'curtail fish dat to narrowest array timeframe 7/26 - 8/15
fish <- fish.dat[fish.dat$date.time >= "2021-07-26 00:00:00" & fish.dat$date.time < "2021-08-15 07:50:00",]
View(fish)
for(i in 1:nrow(fish))
row <- fish[i,]
View(row)
t.match <- arrays[arrays$date.time == row$date.time,] #find matching timestamp
View(t.match)
View(arrays)
View(s2)
s0<- read.csv("data/raw.data/logger.array/blue.ruin.site.0.river.temp.csv")
View(s0)
View(s1)
View(s4)
View(s4)
#rename logger site as s4.netpen - recall two loggers were snagged from the array 5
s4$logger.site[s4$logger.site %in% c("site.5.head")] = "site.4.netpen"
View(s4)
arrays<- do.call("rbind", list(s0, s1, s2, s3, s4))
arrays <- arrays %>% force_tz(arrays$date.time, tzone = "America/Los_Angeles")
for(i in 1:nrow(fish))
row <- fish[i,]
t.match <- arrays[arrays$date.time == row$date.time,] #find matching timestamp
a.match <- t.match[t.match$antenna.number == fish.dat$antenna.number] #find matching array
View(t.match)
arrays<- do.call("rbind", list(s0, s1, s2, s3, s4))
View(arrays)
for(i in 1:nrow(fish)){
row <- fish[i,]
t.match <- arrays[arrays$date.time == row$date.time,] #find matching timestamp
View(t.match)
View(t.match)
View(t.match)
View(t.match)
