#'Randomly generate the number of animals in a study area using a gamma
#'distribution with mean animal abundance of 100 with a standard deviation of
#'25 (hint: use methods of moments) and a Poisson distribution.
?rgamma
#######################################################
## Estimate parameters of gamma with method of moments
#######################################################
gamma.mom<-function(mean,sd){
v<-sd**2
x<-mean
a<- (mean/sd)^2 #shape
b<-(sd^2)/mean #scale
c(a,b)
}
gamma.mom
gamma.mom<-function(mean,sd){
v<-sd**2
x<-mean
a<- (mean/sd)^2 #shape
b<-(sd^2)/mean #scale
c(a,b)
}
gamma.mom(10,25)
gamma.mom(100,25) #what are the shape and scale with a mean of 100 and a sd of 25?
n_reps<-1000
c<-16
b<-6.25
lambda<-rgamma(n_reps,c,b)
x<-rpois(n_reps,lambda) #randomly generated means
n_reps<-1000
my.shape<-16
my.scale<-6.25
lambda<-rgamma(n_reps,my.shape,my.scale)
x<-rpois(n_reps,lambda) #randomly generated means
n_reps<-1000
my.shape<-16
my.scale<-6.25
lambda<-rgamma(n_reps,my.shape, scale = my.scale)
x<-rpois(n_reps,lambda) #randomly generated means
beta.mom<-function(mean,sd){
v<-sd**2
x<-mean
a<-x*(x*(1-x)/v-1)
b<-(1-x)*(x*(1-x)/v-1)
c(a,b)
}
beta.mom(.75, .25)
?beta
n <- 1000
a <- 1.5
b<- 0.5
detection <- rbeta(n, a, b)
?rbeta
capture <- x*detection
capture
mean(capture)
sd(capture)
#' a)	Randomly generate 1000 air temperatures with a mean of 10 and standard
#' deviation of 22
rnorm(1000, 10, 22)
#' beacause air temperatures can be negative and positive, are continuous variables (not discreet)
#' parameters were the mean of 10 and
?rnorm
gamma.mom<-function(mean,sd){
v<-sd**2
x<-mean
a<- (mean/sd)^2 #shape
b<-(sd^2)/mean #scale
c(a,b)
}
gamma.mom(1000,1570)
n_reps<-500
my.shape<-0.405696
my.scale<-2464.90
lambda<-rgamma(n_reps,my.shape, scale = my.scale)
x<-rpois(n_reps,lambda) #randomly generated means
x
max(x)
mean(x)
#' c)	Randomly generate 25 years of hurricane landfalls assuming a mean number of
#' landfalls per year of 4 with a standard deviation of 2.
#' mean and variance are equal, discrete and positive only, poisson
n<- 25
lambda <- 4
hurricane<-rpois(n,lambda)
hurricane
beta.mom<-function(mean,sd){
v<-sd**2
x<-mean
a<-x*(x*(1-x)/v-1)
b<-(1-x)*(x*(1-x)/v-1)
c(a,b)
}
beta.mom(.5, .5) #output alpha and beta with mean of 0.75 and sd of 0.25
